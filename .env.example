# === App ===
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# === Database (PostgreSQL + pgvector) ===
# 예: postgresql+psycopg://user:password@localhost:5432/scholarship
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/scholarship

# === LLM (DeepSeek: OpenAI 호환) ===
# 키가 없으면 규칙기반 폴백으로 동작. 실제 키는 .env에만 넣는다(커밋 금지).
DEEPSEEK_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# DeepSeek는 임베딩 API 미지원 → 로컬 해시 임베딩 폴백 사용
EMBEDDING_DIM=256

# === File upload ===
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

# === Crawling (월간 파이프라인) ===
# 당월 + N개월 후까지 수집 (1 = 당월+익월)
CRAWL_MONTHS_AHEAD=1
CRAWL_RESPECT_ROBOTS=true
CRAWL_DEFAULT_DELAY_SEC=1.5

# 월간 스케줄러 (매월 1일 04:00 KST)
CRAWL_SCHEDULE_ENABLED=true
CRAWL_SCHEDULE_DAY=1
CRAWL_SCHEDULE_HOUR=4
CRAWL_SCHEDULE_MINUTE=0
