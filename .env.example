# === App ===
# development | production
# production 이면 아래 필수값(DEEPSEEK_API_KEY / ADMIN_TOKEN / PG DATABASE_URL /
# localhost 없는 CORS_ORIGINS)이 없을 때 부팅이 실패한다. 조용히 폴백해서
# 반쪽짜리로 서비스되는 것보다 안 켜지는 편이 낫다.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# 프론트 오리진(쉼표 구분). 배포 시 실제 도메인만 남긴다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# /admin/* (크롤·재색인 트리거) 보호. 요청 헤더 X-Admin-Token 으로 보낸다.
# 운영에서는 반드시 채운다. 비우면 production 부팅 실패.
ADMIN_TOKEN=

# === 로그인 세션 ===
SESSION_COOKIE_NAME=benefit_session
SESSION_TTL_DAYS=30
# HTTPS 전용 쿠키. 운영에서 false면 세션이 평문으로 오간다 → production 부팅 실패.
SESSION_COOKIE_SECURE=false
# lax면 다른 사이트발 POST에 쿠키가 실리지 않아 CSRF를 막는다.
# 프론트와 API가 같은 도메인이어야 한다(개발의 Vite 프록시와 동일한 구조).
# 도메인을 분리하려면 none + secure 로 바꾸고 CSRF 토큰을 따로 도입해야 한다.
SESSION_COOKIE_SAMESITE=lax
# scrypt 비용. 2**15=32768 ≈ 110ms. 올릴수록 안전하지만 로그인이 느려진다.
SCRYPT_N=32768
# 로그인·가입 시도 분당 상한(IP 기준). 무차별 대입 방어.
AUTH_RATE_LIMIT_PER_MIN=10

# === 커뮤니티 ===
# HOT / BEST 게시판 편입 기준(공감 수). 커뮤니티가 커지면 올린다.
COMMUNITY_HOT_LIKE_THRESHOLD=10
COMMUNITY_BEST_LIKE_THRESHOLD=50

# === 비밀번호 재설정 ===
# 재설정 링크에 들어갈 프론트 주소. 메일에 그대로 실리므로 실제 접속 가능해야 한다.
# 운영에서 localhost가 남아 있으면 부팅 실패.
APP_BASE_URL=http://localhost:5173
# 링크 수명(분). 짧을수록 안전하지만 메일 확인이 늦으면 놓친다.
PASSWORD_RESET_TTL_MINUTES=30

# === SMTP (stdlib smtplib · 프로바이더 무관) ===
# 비우면 메일을 보내지 않고 링크를 로그로 출력한다(로컬 개발용).
# 운영에서 비어 있으면 부팅 실패.
# Gmail 앱 비밀번호 / 네이버 / AWS SES / Mailgun 모두 동일하게 동작한다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 587 포트는 STARTTLS, 465 포트는 처음부터 TLS(SSL) 이다.
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# === Database (PostgreSQL + pgvector) ===
# 예: postgresql+psycopg://user:password@localhost:5432/scholarship
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/scholarship

# === LLM (DeepSeek: OpenAI 호환) ===
# 키가 없으면 규칙기반 폴백으로 동작. 실제 키는 .env에만 넣는다(커밋 금지).
DEEPSEEK_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# DeepSeek는 임베딩 API 미지원 → 로컬 해시 임베딩 폴백 사용
EMBEDDING_DIM=256
# 외부 LLM 호출 상한. 타임아웃이 없으면 uvicorn 워커가 붙잡혀 전체가 느려진다.
LLM_TIMEOUT_SEC=20
LLM_MAX_RETRIES=2
# /chat/* 분당 호출 상한(클라이언트 IP 기준). LLM 비용 폭주 방지. 0이면 비활성.
CHAT_RATE_LIMIT_PER_MIN=20

# === File upload ===
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

# === Crawling (월간 파이프라인) ===
# 당월 + N개월 후까지 수집 (1 = 당월+익월)
CRAWL_MONTHS_AHEAD=1
CRAWL_RESPECT_ROBOTS=true
CRAWL_DEFAULT_DELAY_SEC=1.5

# 월간 스케줄러 (매월 1일 04:00 KST)
# 주의: 인스턴스 내부 APScheduler라 리더 선출이 없다. 웹 인스턴스를 2대 이상
# 띄우면 크롤이 중복 실행되므로, 한 대에서만 true로 두고 나머지는 false로 배포한다.
CRAWL_SCHEDULE_ENABLED=true
CRAWL_SCHEDULE_DAY=1
CRAWL_SCHEDULE_HOUR=4
CRAWL_SCHEDULE_MINUTE=0
